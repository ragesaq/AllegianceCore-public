<Project Sdk="Microsoft.NET.Sdk">

  <!-- The OpenXR side of the VR client. Only the DesktopGL head references it;
       the shared game library knows just the IVrFrameSink seam, so the browser
       and Android heads carry no OpenXR dependency. Silk.NET ships the managed
       bindings only: the native openxr_loader comes from the user's OpenXR
       runtime install (ALLEGIANCE_OPENXR_LOADER, see VrOptions). -->

  <PropertyGroup>
    <AssemblyName>Allegiance.ClientCore.Vr</AssemblyName>
    <RootNamespace>Allegiance.ClientCore.Vr</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenXR" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenXR.Extensions.KHR" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Allegiance.ClientCore.MonoGame.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Allegiance.ClientCore.Game/Allegiance.ClientCore.Game.csproj" />
  </ItemGroup>

</Project>
